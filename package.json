{
  "name": "eduverse",
  "version": "0.2.0",
  "private": true,
  "description": "EduVerse — Vũ trụ giáo dục ảo: nhiều trường ảo (Dược, Kinh tế, CNTT…) với 2D · 3D · VR · XR · Metaverse · gamification",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "segue:install": "cd pharmacy-ai && npm install",
    "segue:build": "cd pharmacy-ai && npm run build",
    "segue:start": "cd pharmacy-ai && npx next start -p 3100"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  }
}
