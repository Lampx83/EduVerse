# ============================================================
# Tizia — biến môi trường mẫu. Copy thành `.env` và điền giá trị thật.
# ============================================================

# ── Server ──
# PORT=8041
# HOST=0.0.0.0
# BASE_PATH=                       # nếu deploy sau reverse-proxy sub-path, vd "/ps"

# ── Database (Postgres) ──
# Local dev: `docker compose up -d tizia-postgres` → DB ở 127.0.0.1:5433
# Prod: container tizia-postgres trong network 126_default, host=tizia-postgres
DATABASE_URL=postgres://tizia:tizia_dev_pw@127.0.0.1:5433/tizia
# POSTGRES_PASSWORD=tizia_dev_pw   # password mạnh ở prod, đừng commit

# ── Backup / Restore (admin → /api/admin/backups) ──
# pg_dump/pg_restore phải cùng major version với server Postgres. Mac có brew
# postgresql@14 trong PATH mặc định — nếu server là pg16 thì set tay:
# PG_DUMP_BIN=/opt/homebrew/Cellar/postgresql@16/16.14/bin/pg_dump
# PG_RESTORE_BIN=/opt/homebrew/Cellar/postgresql@16/16.14/bin/pg_restore
# BACKUP_DIR=./data/backups        # đổi mount khi prod muốn lưu ra volume riêng
# BACKUP_HOUR=3                    # giờ auto-snapshot (server time, 0–23)
# BACKUP_KEEP=7                    # giữ N file gần nhất
# BACKUP_MAX_BYTES=524288000       # giới hạn file upload restore (500 MB)

# ── Google Analytics 4 ──
# Lấy ở admin.google.com/analytics → Admin → Data Streams → Web → chọn stream
# Measurement ID có dạng G-XXXXXXX (10 ký tự sau G-)
GA_MEASUREMENT_ID=

# API secret cho Measurement Protocol (server-side event: quiz_submit, ai_chat,
# badge_unlock). Tạo ở: Data Streams → Web → Measurement Protocol API secrets
# → Create. KHÔNG commit secret thật vào git.
GA_API_SECRET=

# Bật GA_DEBUG=1 để in log mỗi lần server bắn event + dùng debug endpoint của
# GA4 (xem validation). Tắt ở production.
# GA_DEBUG=0

# ── AI / Ollama ──
# OLLAMA_URL=http://101.96.66.232:8037/ollama/api
# OLLAMA_SECKEY=pharmasim
# OLLAMA_MODEL=qwen2.5:14b-instruct-ctx16k
# OLLAMA_TIMEOUT_MS=60000

# ── Payment (Phase 1) ──
# PAYMENT_ENABLED=0                # đặt =1 để bật route /api/payment/*

# ── ScoreUp Public API (nguồn duy nhất cho câu hỏi trắc nghiệm) ──
# Spec: https://fit.neu.edu.vn/scoreup/v1/api/public/docs (v1.4.0)
# Key cấp qua: docker compose exec api node scripts/create-api-client.js (trên repo ScoreUp)
SCOREUP_BASE_URL=https://fit.neu.edu.vn/scoreup/v1/api/public
SCOREUP_API_KEY=                       # sk_scoreup_partner_<32+hex>, server-side only
SCOREUP_WEBHOOK_SECRET=                # random ≥16 ký tự, dùng khi register webhook

# ── Codelab API (bài tập lập trình + chạy code) ──
# CODELAB_BASE_URL=
# CODELAB_API_KEY=

# ── Legacy reverse-proxy (deprecated, sẽ gỡ) ──
# SCOREUP_TARGET=http://127.0.0.1:3000
# CODELAB_TARGET=http://127.0.0.1:8024
# SMARTDOC_TARGET=http://127.0.0.1:8017
# FEEDBACKME_TARGET=http://127.0.0.1:8020
