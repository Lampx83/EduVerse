# Caddy reverse-proxy config for EduVerse
#
# Two common patterns supported:
#
#   1. SUBDOMAIN (easiest, no app config needed):
#      Domain: ps.tizia.vn  →  reverse_proxy eduverse:8041
#      Run app with BASE_PATH unset (default).
#
#   2. PATH (tizia.vn/ps/*):
#      Domain: tizia.vn   →  handle /ps/* {…}
#      Caddy passes /ps/* through without stripping; app must run with
#      BASE_PATH=/ps so its routes match.
#
# Toggle by uncommenting the block you want. Set DOMAIN env var when launching:
#   DOMAIN=ps.tizia.vn ACME_EMAIL=you@email.com \
#     docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d

# ============================================================
# Pattern 1 — Subdomain (recommended)
# ============================================================
{$DOMAIN} {
	tls {$EMAIL}

	reverse_proxy eduverse:8041 {
		# WebSocket upgrade headers — required for /ws and /ws-race
		header_up Connection {http.request.header.Connection}
		header_up Upgrade {http.request.header.Upgrade}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=()"
	}
	encode zstd gzip
	log { output stdout }
}

# ============================================================
# Pattern 2 — Path-based (uncomment + set BASE_PATH=/ps env in compose)
# ============================================================
# tizia.vn {
# 	tls {$EMAIL}
#
# 	handle /ps/* {
# 		reverse_proxy eduverse:8041 {
# 			header_up Connection {http.request.header.Connection}
# 			header_up Upgrade {http.request.header.Upgrade}
# 		}
# 	}
# 	handle / {
# 		respond "tizia.vn — apps: /ps" 200
# 	}
# }
